# WEVIDEO-APP — cấu hình (copy máy khác: sửa ở đây, không sửa code)
APP_PORT=8080

# flow-agent (engine gen Veo qua Google Flow). Phải chạy + extension đã nạp + đã login Flow.
FLOW_AGENT_URL=http://127.0.0.1:8001

# Giọng: edge-tts (miễn phí). Nữ: vi-VN-HoaiMyNeural. Rate dải -10%..+50%.
VOICE=vi-VN-NamMinhNeural
VOICE_RATE=+8%
VOICE_GAP=0.30

# LLM enrich (tuỳ chọn, OpenAI-compatible): sinh prompt HÌNH tiếng Anh + phụ đề kinetic từ câu tiếng Việt.
# Thiếu/không chạy → app tự dùng template (video vẫn ra, hình chung chung hơn).
# VD 9Router cùng máy: http://127.0.0.1:20128/v1 · model cc/claude-sonnet-4-6
LLM_URL=http://127.0.0.1:20128/v1
LLM_MODEL=cc/claude-sonnet-4-6
LLM_KEY=

# Mặc định dựng
STYLE=phan
# Khung hình mặc định: 9:16 (dọc) | 16:9 (ngang)
ASPECT=9:16
# Nguồn hình mỗi cảnh: video (clip Veo động) | image (ảnh Flow tĩnh + zoom, rẻ credit)
VISUAL=video
DURATION=4
TRANSITION=hardcut
ZOOM=auto
SPEED=1.15

# Hiệu ứng edit thêm
AUTO_BROLL=off
SFX=on
SFX_GAIN=0.3

# Tăng sức hút (script→video): màu điện ảnh + nhạc nền
GRADE=cine
MUSIC=off
MUSIC_GAIN=0.12
