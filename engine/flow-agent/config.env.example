# config.env.example — mẫu cấu hình engine flow-agent (KHÔNG secret).
# setup.sh sẽ copy file này thành config.env nếu chưa có. Sửa config.env theo máy.
# DEFAULT_PROJECT: để TRỐNG — engine UI transport lấy project từ TAB Flow đang mở.
# Muốn cố định 1 project thì điền id của TÀI KHOẢN trên MÁY NÀY (không phải máy build).
DEFAULT_PROJECT=
IMAGE_MODEL=NARWHAL
SERVER_API_KEY=
MAX_CONCURRENT_REQUESTS=5
REQUEST_MIN_INTERVAL=3
WS_PORT=9227
HTTP_PORT=8100
OPENAI_API_HOST=127.0.0.1
OPENAI_API_PORT=8001
POLL_INTERVAL=10
POLL_TIMEOUT=420
API_REQUEST_TIMEOUT=180
API_BASE=https://aisandbox-pa.googleapis.com
FLOW_TRANSPORT=ui
